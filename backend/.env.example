# Copy this template to .env for the environment used by the current branch.
# Never commit real tokens, database passwords, or service-role keys.
APP_ENV=development
PORT=3000

# Supabase project identifiers and public client connection values.
SUPABASE_PROJECT_NAME="XPENSE Development"
SUPABASE_PROJECT_ID=replace-with-project-id
SUPABASE_URL=https://replace-with-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key

# Cloudflare Workers AI credentials used only by the backend.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
